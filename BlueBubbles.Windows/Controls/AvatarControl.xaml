<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BlueBubbles.Windows.Controls.AvatarControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <!-- Single avatar (1:1 chat or fallback) -->
        <Grid x:Name="SingleAvatar">
            <PersonPicture x:Name="PersonPic" />
            <Grid x:Name="InitialsCircle" Visibility="Collapsed" CornerRadius="100">
                <Ellipse x:Name="InitialsEllipse" />
                <TextBlock x:Name="InitialsText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold" />
                <!-- Generic person glyph shown when no contact name/photo is available -->
                <FontIcon x:Name="PersonGlyph"
                          Glyph="&#xE77B;"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
            </Grid>
        </Grid>

        <!-- Group avatar (stacked) -->
        <Grid x:Name="GroupAvatar" Visibility="Collapsed">
            <Grid x:Name="GroupBack"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top">
                <Ellipse x:Name="GroupBackEllipse" />
                <TextBlock x:Name="GroupBackInitials"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold" />
                <FontIcon x:Name="GroupBackGlyph"
                          Glyph="&#xE77B;"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                <Ellipse x:Name="GroupBackImage" Visibility="Collapsed" />
            </Grid>
            <Grid x:Name="GroupFront"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom">
                <Ellipse x:Name="GroupFrontEllipse" />
                <TextBlock x:Name="GroupFrontInitials"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontWeight="SemiBold" />
                <FontIcon x:Name="GroupFrontGlyph"
                          Glyph="&#xE77B;"
                          Foreground="White"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
                <Ellipse x:Name="GroupFrontImage" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
