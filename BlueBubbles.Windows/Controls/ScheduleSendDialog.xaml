<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BlueBubbles.Windows.Controls.ScheduleSendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Schedule message"
    PrimaryButtonText="Schedule"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">

    <StackPanel Spacing="12" MinWidth="320">
        <TextBox x:Name="MessageBox"
                 Header="Message"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 MaxHeight="120"
                 AutomationProperties.Name="Message text" />

        <CalendarDatePicker x:Name="DatePicker"
                            Header="Date"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Send date" />

        <TimePicker x:Name="TimeOfDayPicker"
                    Header="Time"
                    MinuteIncrement="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Send time" />

        <InfoBar x:Name="ValidationBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>
