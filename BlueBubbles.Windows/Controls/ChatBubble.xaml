<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BlueBubbles.Windows.Controls.ChatBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Padding="0,1" HorizontalAlignment="Stretch">
        <StackPanel HorizontalAlignment="Stretch">
        <Border x:Name="BubbleBorder" Padding="12,8" CornerRadius="18" MaxWidth="500">
            <StackPanel x:Name="ContentPanel">
                <!-- Reply indicator: accent left bar + quoted snippet of the original message -->
                <Grid x:Name="ReplyIndicator"
                      Visibility="Collapsed"
                      Margin="0,0,0,6"
                      ColumnSpacing="8"
                      Tapped="OnReplyIndicatorTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="ReplyAccentBar" Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="ReplySenderText" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReplySnippetText"
                                   FontSize="12"
                                   Opacity="0.85"
                                   MaxLines="2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SenderText"
                           FontWeight="SemiBold"
                           FontSize="12"
                           Margin="0,0,0,2"
                           Visibility="Collapsed" />
                <TextBlock x:Name="SubjectText"
                           FontWeight="Bold"
                           Margin="0,0,0,4"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <!-- Attachment display area -->
                <StackPanel x:Name="AttachmentsPanel"
                            Spacing="4"
                            Margin="0,0,0,0"
                            Visibility="Collapsed" />
                <!-- Rich link (URL) preview card -->
                <StackPanel x:Name="UrlPreviewPanel"
                            Margin="0,2,0,0"
                            Visibility="Collapsed" />
                <TextBlock x:Name="MessageText"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True" />
                <StackPanel x:Name="MetaPanel"
                            Orientation="Horizontal"
                            Spacing="6"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0">
                    <TextBlock x:Name="EditedText"
                               Text="Edited"
                               FontSize="11"
                               FontStyle="Italic"
                               Opacity="0.6"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TimeText" FontSize="11" Opacity="0.6" />
                    <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.6" />
                    <HyperlinkButton x:Name="CancelLink"
                                     Content="Cancel"
                                     FontSize="11"
                                     Padding="0"
                                     MinWidth="0"
                                     MinHeight="0"
                                     Visibility="Collapsed"
                                     Click="OnCancelClick" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Reaction pills, aligned to the bubble's side and tucked under its lower corner -->
        <StackPanel x:Name="ReactionsPanel"
                    Orientation="Horizontal"
                    Spacing="4"
                    Margin="8,-8,8,2"
                    Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
