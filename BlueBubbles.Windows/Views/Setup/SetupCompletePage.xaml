<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Setup.SetupCompletePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
          MaxWidth="420" Padding="24">
        <StackPanel Spacing="32" HorizontalAlignment="Center">
            <FontIcon Glyph="&#xE10B;"
                      FontSize="64"
                      Foreground="{ThemeResource SystemAccentColor}"
                      HorizontalAlignment="Center" />

            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="You're All Set!"
                           Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Your messages have been synced and you're ready to go."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="320" />
            </StackPanel>

            <Button Content="Enter BlueBubbles"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center"
                    Padding="32,10"
                    Click="OnEnterAppClick" />
        </StackPanel>
    </Grid>
</Page>
