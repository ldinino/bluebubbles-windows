<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Setup.SyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
          MaxWidth="420" Padding="24">
        <StackPanel Spacing="32">
            <Image Source="/Assets/AppIcon-256.png"
                   Width="80" Height="80"
                   HorizontalAlignment="Center" />

            <TextBlock Text="Syncing Your Messages"
                       Style="{StaticResource TitleTextBlockStyle}"
                       HorizontalAlignment="Center" />

            <StackPanel Spacing="12">
                <ProgressBar x:Name="SyncProgressBar"
                             Minimum="0" Maximum="100"
                             IsIndeterminate="True" />

                <TextBlock x:Name="SyncStatusText"
                           Text="Starting sync..."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
            </StackPanel>

            <InfoBar x:Name="SyncErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="False" />

            <TextBlock Text="This may take a few minutes depending on your message history."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
