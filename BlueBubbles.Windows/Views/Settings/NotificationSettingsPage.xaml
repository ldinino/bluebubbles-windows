<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Settings.NotificationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="900">

            <TextBlock Text="Notifications"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <tk:SettingsCard Header="Notify for messages in unfocused chats"
                             Description="Show a toast when a message arrives and no chat is open">
                <ToggleSwitch IsOn="{x:Bind Settings.NotifyOnChatList, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Notify for reactions"
                             Description="Show a toast when someone reacts to a message">
                <ToggleSwitch IsOn="{x:Bind Settings.NotifyReactions, Mode=TwoWay}" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Filter unknown senders"
                             Description="Suppress notifications from addresses not in your contacts">
                <ToggleSwitch IsOn="{x:Bind Settings.FilterUnknownSenders, Mode=TwoWay}" />
            </tk:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
