<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Settings.BackupSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="900">

            <TextBlock Text="Backup &amp; Restore"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,8" />

            <TextBlock Text="Back up your app settings and theme to the BlueBubbles server so you can restore them on another device."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <tk:SettingsCard Header="Settings backup"
                             Description="Save messaging, notification, appearance and Private API preferences to the server">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveSettingsButton" Content="Save" Click="OnSaveSettingsClick" />
                    <Button x:Name="RestoreSettingsButton" Content="Restore" Click="OnRestoreSettingsClick" />
                    <Button x:Name="DeleteSettingsButton" Content="Delete" Click="OnDeleteSettingsClick" />
                </StackPanel>
            </tk:SettingsCard>

            <TextBlock Text="Export conversations"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,28,0,4" />

            <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"
                       Text="Save chat history to a folder on this PC as a readable transcript and a machine-readable JSONL file. This is an export only - there is no way to import it back." />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Warning"
                     Title="Exports contain only what this PC has already downloaded"
                     Margin="0,0,0,8"
                     Message="Your message history lives on your Mac. This app keeps a local copy of the parts you have scrolled back through, so an export can be missing older messages. Every exported conversation states how far back it actually reaches - read that before relying on one as a record. To include more, open a conversation and scroll back to load older messages first." />

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Margin="0,0,0,8"
                     Message="Exported files are unencrypted plain text." />

            <tk:SettingsExpander x:Name="ExportExpander"
                                 Header="Conversations to export"
                                 Description="Nothing selected">
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <AutoSuggestBox x:Name="ChatFilterBox"
                                                    PlaceholderText="Filter conversations"
                                                    QueryIcon="Find"
                                                    MinWidth="260"
                                                    TextChanged="OnChatFilterChanged" />
                                    <Button x:Name="SelectAllButton" Content="Select all" Click="OnSelectAllClick" />
                                    <Button x:Name="SelectNoneButton" Content="Clear" Click="OnSelectNoneClick" />
                                </StackPanel>
                                <ListView x:Name="ChatList"
                                          SelectionMode="Multiple"
                                          Height="240"
                                          MinWidth="420"
                                          SelectionChanged="OnChatSelectionChanged"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="0,6">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Coverage}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </tk:SettingsCard.Header>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <tk:SettingsCard Header="Readable transcript"
                             Description="Also write a plain-text .txt transcript beside each .jsonl file">
                <ToggleSwitch x:Name="TranscriptToggle" IsOn="True" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Include attachments"
                             Description="Copy photos and files that are already downloaded to this PC. Anything not downloaded is listed as missing - the export never fetches from the server.">
                <ToggleSwitch x:Name="AttachmentsToggle" IsOn="True" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Export"
                             Description="Choose a destination folder and write the selected conversations">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressRing x:Name="ExportProgressRing"
                                  IsActive="False"
                                  Width="20"
                                  Height="20" />
                    <TextBlock x:Name="ExportProgressText"
                               Visibility="Collapsed"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button x:Name="ExportButton"
                            Content="Export..."
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnExportClick" />
                    <Button x:Name="CancelExportButton"
                            Content="Cancel"
                            Visibility="Collapsed"
                            Click="OnCancelExportClick" />
                </StackPanel>
            </tk:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
