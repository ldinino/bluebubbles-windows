<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Settings.BackupSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="900">

            <TextBlock Text="Backup &amp; Restore"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <InfoBar x:Name="StatusBar"
                     IsOpen="False"
                     IsClosable="True"
                     Margin="0,0,0,8" />

            <TextBlock Text="Back up your app settings and theme to the BlueBubbles server so you can restore them on another device."
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />

            <tk:SettingsCard Header="Settings backup"
                             Description="Save messaging, notification and Private API preferences to the server">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveSettingsButton" Content="Save" Click="OnSaveSettingsClick" />
                    <Button x:Name="RestoreSettingsButton" Content="Restore" Click="OnRestoreSettingsClick" />
                    <Button x:Name="DeleteSettingsButton" Content="Delete" Click="OnDeleteSettingsClick" />
                </StackPanel>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Theme backup"
                             Description="Save your theme and appearance choices to the server">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SaveThemeButton" Content="Save" Click="OnSaveThemeClick" />
                    <Button x:Name="RestoreThemeButton" Content="Restore" Click="OnRestoreThemeClick" />
                    <Button x:Name="DeleteThemeButton" Content="Delete" Click="OnDeleteThemeClick" />
                </StackPanel>
            </tk:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
