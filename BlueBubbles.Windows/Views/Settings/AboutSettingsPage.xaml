<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="900">

            <TextBlock Text="About"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <Image x:Name="AppLogoImage" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BlueBubbles for Windows"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AppVersionText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <tk:SettingsCard Header="App version">
                <TextBlock x:Name="AppVersionValue" Style="{StaticResource BodyTextBlockStyle}" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Server version">
                <TextBlock x:Name="ServerVersionValue"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="Loading..." />
            </tk:SettingsCard>

            <TextBlock Text="LINKS"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="4,16,0,4" />

            <tk:SettingsCard Header="GitHub"
                             Description="Source code and issue tracker"
                             IsClickEnabled="True"
                             Click="OnGitHubClick">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Documentation"
                             Description="Setup guides and reference"
                             IsClickEnabled="True"
                             Click="OnDocsClick">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
