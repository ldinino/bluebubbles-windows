<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.Settings.AboutSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
        <StackPanel Padding="32,24" Spacing="4" MaxWidth="900">

            <TextBlock Text="About"
                       Style="{StaticResource TitleTextBlockStyle}"
                       Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,12">
                <Image x:Name="AppLogoImage" Width="48" Height="48" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BlueBubbles for Windows"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AppVersionText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <tk:SettingsCard Header="App version">
                <TextBlock x:Name="AppVersionValue" Style="{StaticResource BodyTextBlockStyle}" />
            </tk:SettingsCard>

            <tk:SettingsCard Header="Updates"
                             Description="Checks GitHub Releases. Updates are never installed automatically.">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateStatusText"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Button x:Name="CheckForUpdatesButton"
                            Content="Check for updates"
                            Click="OnCheckForUpdatesClick" />
                </StackPanel>
            </tk:SettingsCard>

            <InfoBar x:Name="UpdateInfoBar"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Informational"
                     Margin="0,4">
                <InfoBar.ActionButton>
                    <Button x:Name="UpdateActionButton"
                            Content="Download and install"
                            Click="OnDownloadUpdateClick" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Minimum="0" Maximum="1"
                                 Visibility="Collapsed"
                                 Margin="0,4,0,12" />
                </InfoBar.Content>
            </InfoBar>

            <tk:SettingsCard Header="Server version">
                <TextBlock x:Name="ServerVersionValue"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Text="Loading..." />
            </tk:SettingsCard>

            <TextBlock Text="DIAGNOSTICS"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="4,16,0,4" />

            <tk:SettingsCard Header="Verbose logging"
                             Description="Capture extra Debug-level detail (e.g. avatar load/recycle) in the log below. Leave off for normal use; turn on to reproduce and report intermittent issues.">
                <ToggleSwitch x:Name="VerboseLoggingToggle"
                              Toggled="OnVerboseLoggingToggled" />
            </tk:SettingsCard>

            <tk:SettingsExpander Header="Diagnostic log"
                                 Description="Recent activity from across the app — connection, sync, contacts, and more. Filter by category or export it to attach to a bug report.">
                <tk:SettingsExpander.ItemsHeader>
                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,8"
                                VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Category" VerticalAlignment="Center" />
                        <ComboBox x:Name="LogCategoryCombo"
                                  MinWidth="120"
                                  SelectionChanged="OnLogCategoryChanged" />
                        <Button Content="Export Logs" Click="OnExportLogsClick" />
                        <Button Content="Copy All" Click="OnCopyLogClick" />
                        <Button Content="Clear" Click="OnClearLogClick" />
                    </StackPanel>
                </tk:SettingsExpander.ItemsHeader>
                <tk:SettingsExpander.Items>
                    <tk:SettingsCard>
                        <tk:SettingsCard.Header>
                            <TextBox x:Name="LogTextBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     MinWidth="600"
                                     MaxHeight="300"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </tk:SettingsCard.Header>
                    </tk:SettingsCard>
                </tk:SettingsExpander.Items>
            </tk:SettingsExpander>

            <TextBlock Text="LINKS"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="4,16,0,4" />

            <tk:SettingsCard Header="GitHub"
                             Description="Source code and issue tracker"
                             IsClickEnabled="True"
                             Click="OnGitHubClick">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <tk:SettingsCard Header="Documentation"
                             Description="Setup guides and reference"
                             IsClickEnabled="True"
                             Click="OnDocsClick">
                <tk:SettingsCard.ActionIcon>
                    <FontIcon Glyph="&#xE8A7;" />
                </tk:SettingsCard.ActionIcon>
            </tk:SettingsCard>

            <!-- Danger zone -->
            <TextBlock Text="DANGER ZONE"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       Margin="4,16,0,4" />
            <tk:SettingsCard Header="Reset app"
                             Description="Delete all local data (chats, messages, contacts, settings) and return to setup">
                <Button x:Name="ResetAppButton"
                        Content="Reset App"
                        Click="OnResetAppClick"
                        Background="{ThemeResource SystemFillColorCriticalBrush}"
                        Foreground="White" />
            </tk:SettingsCard>

        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
