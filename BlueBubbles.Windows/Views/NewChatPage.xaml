<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.NewChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BlueBubbles.Windows.Controls"
    xmlns:converters="using:BlueBubbles.Windows.Converters"
    xmlns:vm="using:BlueBubbles.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="12,12,16,12"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OnGoBackClick"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Back"
                    AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="New Message"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- Recipients area -->
        <Grid Grid.Row="1"
              Padding="16,12,16,8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Recipient chips -->
            <ScrollViewer x:Name="ChipsScroller"
                          Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Visibility="Collapsed"
                          Margin="0,0,0,8">
                <ItemsRepeater x:Name="ChipsRepeater">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectedRecipient">
                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="14"
                                    Padding="10,4,4,4"
                                    Height="28">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <!-- Availability indicator -->
                                    <ProgressRing IsActive="{x:Bind IsCheckingAvailability, Mode=OneWay}"
                                                  Width="12" Height="12"
                                                  Visibility="{x:Bind IsCheckingAvailability, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind DisplayName}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center" />
                                    <Button Tag="{x:Bind}"
                                            Click="OnRemoveChipClick"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,2"
                                            MinWidth="0" MinHeight="0"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Search input -->
            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="To:"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBox x:Name="RecipientSearchBox"
                         Grid.Column="1"
                         PlaceholderText="Type a name, phone, or email"
                         BorderThickness="0"
                         Background="Transparent"
                         TextChanged="OnRecipientSearchTextChanged"
                         KeyDown="OnRecipientSearchKeyDown" />
            </Grid>
        </Grid>

        <!-- Search results -->
        <Grid Grid.Row="2">
            <!-- Contact results list -->
            <ListView x:Name="ResultsList"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="OnResultItemClick"
                      Padding="4,4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ContactAddressItem">
                        <Grid Padding="8,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:AvatarControl Grid.RowSpan="2"
                                                    Size="36"
                                                    Initials="{x:Bind Initials}"
                                                    AvatarImage="{x:Bind Avatar}"
                                                    VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" Grid.Row="0"
                                       Text="{x:Bind DisplayName}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       Text="{x:Bind FormattedAddress}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />

                            <FontIcon Grid.Column="2" Grid.RowSpan="2"
                                      Glyph="&#xE717;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind IsPhone, Converter={StaticResource BoolToVis}}" />
                            <FontIcon Grid.Column="2" Grid.RowSpan="2"
                                      Glyph="&#xE715;"
                                      FontSize="14"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      VerticalAlignment="Center"
                                      Visibility="{x:Bind IsPhone, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Manual add option -->
            <StackPanel x:Name="ManualAddPanel"
                        Visibility="Collapsed"
                        VerticalAlignment="Top"
                        Padding="16,8">
                <Button x:Name="ManualAddButton"
                        Click="OnManualAddClick"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE710;" FontSize="16"
                                  Foreground="{ThemeResource SystemAccentColor}"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="ManualAddText"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Empty state (no search, no recipients) -->
            <StackPanel x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <FontIcon Glyph="&#xE779;"
                          FontSize="36"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Search for contacts or type an address"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Error bar -->
        <InfoBar x:Name="ErrorBar"
                 Grid.Row="3"
                 IsOpen="False"
                 IsClosable="True"
                 Severity="Error"
                 Margin="8,0" />

        <!-- Composer -->
        <controls:MessageComposer x:Name="Composer"
                                  Grid.Row="4"
                                  IsEnabled="False" />
    </Grid>
</Page>
