<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BlueBubbles.Windows.Controls"
    xmlns:views="using:BlueBubbles.Windows.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <!-- Adaptive master/detail. Wide: list + detail side by side. Narrow (< ~768px there isn't room
         for both): a single pane fills the window and we swap between the list and the open chat,
         driven from code-behind (ApplyPaneLayout) because the choice depends on both width AND
         whether a chat is open — a condition pure AdaptiveTriggers can't express. -->
    <!-- KeyboardAcceleratorPlacementMode="Hidden": these are app-global shortcuts on the full-window
         Grid, not bound to any hovered button. Hidden suppresses WinUI's auto-generated key-combo
         tooltip, which otherwise leaks over the conversation list on first show (B1). -->
    <Grid SizeChanged="OnRootSizeChanged"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewChatAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnFindAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="320" MinWidth="280" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Conversation List -->
        <Grid x:Name="LeftPane"
              Grid.Column="0"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,1,0">
            <views:ConversationListPage x:Name="ConversationListPane" />
        </Grid>

        <!-- Draggable Divider -->
        <controls:DraggableDivider x:Name="PaneDivider"
                                    Grid.Column="1"
                                    Width="8"
                                    Background="Transparent"
                                    ManipulationMode="TranslateX"
                                    ManipulationDelta="OnDividerDrag" />

        <!-- Right Pane: Chat Detail (populated in Phase 6) -->
        <Grid x:Name="RightPane"
              Grid.Column="2">

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <FontIcon Glyph="&#xE8BD;"
                          FontSize="48"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          HorizontalAlignment="Center" />
                <TextBlock Text="Select a conversation to start messaging"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Chat frame (populated in Phase 6). Opening a conversation should swap in instantly,
                 not slide/fade (L2). A Frame ships with a default NavigationThemeTransition, so we
                 must set an EMPTY TransitionCollection to actually suppress it — otherwise every
                 chat switch plays the built-in slide-up + fade. -->
            <Frame x:Name="ChatFrame" Visibility="Collapsed">
                <Frame.ContentTransitions>
                    <TransitionCollection />
                </Frame.ContentTransitions>
            </Frame>
        </Grid>
    </Grid>
</Page>
