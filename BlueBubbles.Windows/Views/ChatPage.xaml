<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BlueBubbles.Windows.Controls"
    xmlns:vm="using:BlueBubbles.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <!-- Message bubble template -->
        <DataTemplate x:Key="MessageTemplate" x:DataType="vm:MessageBubbleViewModel">
            <controls:ChatBubble />
        </DataTemplate>

        <!-- Date separator template -->
        <DataTemplate x:Key="DateSeparatorTemplate" x:DataType="vm:DateSeparatorViewModel">
            <TextBlock Text="{x:Bind Label}"
                       HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,12,0,4" />
        </DataTemplate>

        <controls:ChatItemTemplateSelector x:Key="ChatTemplateSelector"
            MessageTemplate="{StaticResource MessageTemplate}"
            DateSeparatorTemplate="{StaticResource DateSeparatorTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Padding="16,10"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Narrow-layout "back to conversations" affordance. Hidden in wide layout
                     (the list is always visible there); the shell toggles it via SetNarrow. -->
                <Button x:Name="NarrowBackButton"
                        Visibility="Collapsed"
                        Click="OnBackToListClick"
                        ToolTipService.ToolTip="Back to conversations"
                        AutomationProperties.Name="Back to conversations"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <controls:AvatarControl x:Name="HeaderAvatar" Size="36" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderName"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HeaderInfo"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button x:Name="InfoButton"
                    Grid.Column="2"
                    Click="OnInfoClick"
                    ToolTipService.ToolTip="Chat details"
                    AutomationProperties.Name="Chat details"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Messages list: natural order (oldest at top, newest at bottom) -->
        <Grid Grid.Row="1">
            <ListView x:Name="MessagesList"
                      ItemTemplateSelector="{StaticResource ChatTemplateSelector}"
                      SelectionMode="None"
                      Padding="16,8,16,8">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel VerticalAlignment="Bottom"
                                         ItemsUpdatingScrollMode="KeepLastItemInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <!-- No ItemContainerTransitions: messages must appear instantly when a thread
                     loads. AddDeleteThemeTransition animated every row in on open (and on each
                     new message), which read as a distracting load animation (L). -->
            </ListView>

            <!-- Loading indicator for older messages -->
            <ProgressRing x:Name="LoadingRing"
                          IsActive="False"
                          Width="24" Height="24"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Margin="0,8,0,0" />

            <!-- Scroll to bottom FAB -->
            <Button x:Name="ScrollToBottomBtn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,20,20"
                    Visibility="Collapsed"
                    Width="40" Height="40"
                    CornerRadius="20"
                    Padding="0"
                    Click="OnScrollToBottomClick"
                    ToolTipService.ToolTip="Scroll to bottom"
                    AutomationProperties.Name="Scroll to bottom">
                <FontIcon Glyph="&#xE74B;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Typing indicator: its own row so it pushes the thread up instead of overlapping it -->
        <controls:TypingIndicator x:Name="TypingDots"
                                  Grid.Row="2"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Left"
                                  Margin="16,2,0,6" />

        <!-- Composer -->
        <Border Grid.Row="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <controls:MessageComposer x:Name="Composer" />
        </Border>
    </Grid>
</Page>
