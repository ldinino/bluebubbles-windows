<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueBubbles.Windows.Views.ConversationListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BlueBubbles.Windows.Controls"
    xmlns:converters="using:BlueBubbles.Windows.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BlueBubbles.Windows.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DateTimeToRelativeConverter x:Key="RelativeTimeConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Connection / sync status: a slim, single-line bar (spinner or icon + text) -->
        <Border x:Name="ConnectionBar"
                Grid.Row="0"
                Padding="12,6"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ProgressRing x:Name="ConnectionBarRing"
                              Width="14"
                              Height="14"
                              IsActive="False"
                              Visibility="Collapsed" />
                <FontIcon x:Name="ConnectionBarIcon"
                          FontSize="14"
                          Glyph="&#xE7BA;"
                          Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionBarText"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Archived Header (visible only when browsing archive) -->
        <StackPanel x:Name="ArchivedHeader"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="12,8,12,0"
                    Visibility="Collapsed">
            <Button Click="OnBackFromArchiveClick"
                    Padding="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Back to conversations"
                    AutomationProperties.Name="Back to conversations">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock Text="Archived"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Search + Compose -->
        <Grid Grid.Row="2" Margin="12,12,12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="SearchBox"
                            PlaceholderText="Search conversations"
                            QueryIcon="Find"
                            AutomationProperties.Name="Search conversations"
                            TextChanged="OnSearchTextChanged" />
            <Button Grid.Column="1"
                    Click="OnNewChatClick"
                    Padding="8"
                    ToolTipService.ToolTip="New message"
                    AutomationProperties.Name="New message"
                    VerticalAlignment="Center">
                <FontIcon Glyph="&#xE70F;" FontSize="16" />
            </Button>
        </Grid>

        <!-- Pinned Conversations -->
        <StackPanel x:Name="PinnedSection"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Margin="12,8,12,4">
            <GridView x:Name="PinnedGrid"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnPinnedItemClick"
                      CanReorderItems="True"
                      AllowDrop="True"
                      DragItemsCompleted="OnPinnedDragCompleted"
                      Padding="0"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.HorizontalScrollMode="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 3-column grid; cell width is scaled to fill the pane in code-behind. -->
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="3"
                                       ItemWidth="96"
                                       ItemHeight="96" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConversationTileViewModel">
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="4"
                                    Padding="4">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Unpin"
                                                    Tag="{x:Bind ChatGuid}"
                                                    Click="OnTogglePinClick">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77A;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Mark as Read"
                                                    Icon="Read"
                                                    Tag="{x:Bind ChatGuid}"
                                                    Click="OnMarkReadClick" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Grid>
                                <controls:AvatarControl Size="56"
                                                        Initials="{x:Bind Initials, Mode=OneWay}"
                                                        AvatarImage="{x:Bind AvatarBytes, Mode=OneWay}"
                                                        IsGroup="{x:Bind IsGroup, Mode=OneWay}"
                                                        GroupInitials1="{x:Bind GroupInitials1, Mode=OneWay}"
                                                        GroupInitials2="{x:Bind GroupInitials2, Mode=OneWay}"
                                                        GroupAvatarImage1="{x:Bind GroupAvatarBytes1, Mode=OneWay}"
                                                        GroupAvatarImage2="{x:Bind GroupAvatarBytes2, Mode=OneWay}" />
                                <InfoBadge Value="1"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Right"
                                           Visibility="{x:Bind HasUnread, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            </Grid>
                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>

        <!-- Conversation List -->
        <ListView x:Name="ConversationList"
                  Grid.Row="4"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnConversationItemClick"
                  Padding="4,0">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                    <ContentThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ConversationTileViewModel">
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="{x:Bind DividerThickness, Mode=OneWay}">
                    <Grid Padding="{x:Bind TilePadding, Mode=OneWay}" ColumnSpacing="12">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Mark as Read"
                                                Icon="Read"
                                                Tag="{x:Bind ChatGuid}"
                                                Click="OnMarkReadClick"
                                                Visibility="{x:Bind IsArchived, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}" />
                                <MenuFlyoutItem Text="Pin"
                                                Tag="{x:Bind ChatGuid}"
                                                Click="OnTogglePinClick"
                                                Visibility="{x:Bind IsArchived, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE718;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Archive"
                                                Tag="{x:Bind ChatGuid}"
                                                Click="OnArchiveClick"
                                                Visibility="{x:Bind IsArchived, Converter={StaticResource InverseBoolToVis}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Unarchive"
                                                Tag="{x:Bind ChatGuid}"
                                                Click="OnUnarchiveClick"
                                                Visibility="{x:Bind IsArchived, Converter={StaticResource BoolToVis}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7A7;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete"
                                                Icon="Delete"
                                                Tag="{x:Bind ChatGuid}"
                                                Click="OnDeleteClick" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Avatar -->
                        <controls:AvatarControl Grid.RowSpan="2"
                                                Size="40"
                                                Initials="{x:Bind Initials, Mode=OneWay}"
                                                AvatarImage="{x:Bind AvatarBytes, Mode=OneWay}"
                                                IsGroup="{x:Bind IsGroup, Mode=OneWay}"
                                                GroupInitials1="{x:Bind GroupInitials1, Mode=OneWay}"
                                                GroupInitials2="{x:Bind GroupInitials2, Mode=OneWay}"
                                                GroupAvatarImage1="{x:Bind GroupAvatarBytes1, Mode=OneWay}"
                                                GroupAvatarImage2="{x:Bind GroupAvatarBytes2, Mode=OneWay}"
                                                VerticalAlignment="Center" />

                        <!-- Name -->
                        <TextBlock Grid.Column="1" Grid.Row="0"
                                   Text="{x:Bind DisplayName, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Timestamp -->
                        <TextBlock Grid.Column="2" Grid.Row="0"
                                   Text="{x:Bind Timestamp, Converter={StaticResource RelativeTimeConverter}, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Preview + unread dot -->
                        <Grid Grid.Column="1" Grid.Row="1"
                              Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Preview, Mode=OneWay}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{x:Bind ShowStatusIndicator, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                                <Ellipse Width="10" Height="10"
                                         Fill="{ThemeResource SystemAccentColor}"
                                         VerticalAlignment="Center"
                                         Visibility="{x:Bind HasUnread, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Loading -->
        <ProgressRing x:Name="LoadingRing"
                      Grid.Row="4"
                      IsActive="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />

        <!-- Bottom bar -->
        <Grid x:Name="BottomBar"
              Grid.Row="5"
              Padding="12,8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left"
                    Click="OnSettingsClick"
                    ToolTipService.ToolTip="Settings"
                    AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <Button Grid.Column="2"
                    HorizontalAlignment="Right"
                    Click="OnArchiveViewClick"
                    ToolTipService.ToolTip="Archived"
                    AutomationProperties.Name="Archived conversations">
                <FontIcon Glyph="&#xE7B8;" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</Page>
