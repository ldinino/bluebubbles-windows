<?xml version="1.0" encoding="utf-8"?>
<!--
  Unpackaged, self-contained publish profile (sideload-free distribution).
  Produces a folder with BlueBubbles.Windows.exe + the bundled .NET and Windows App SDK
  runtimes, so it runs on a clean machine with no prerequisites and no MSIX/certificate. WinUI3
  cannot be a true single file (native components), so the output is a folder — zip it or wrap
  it with the Inno Setup installer (see installer/ and publish.ps1).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>False</PublishSingleFile>
    <!-- Run without package identity (no MSIX / no certificate). -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bundle the Windows App SDK runtime so the target needs nothing pre-installed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Trimming is unsafe for XAML/reflection-heavy WinUI; R2R off keeps publish fast. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
