<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>BlueBubbles.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embeds the app icon into the .exe so Explorer and Start-menu/desktop shortcuts show it. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- We provide our own entry point (Program.cs) for single-instancing. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Single source of truth for the app version. 3-part semantic version:
      Major.Minor.Patch. Bump this one value to release; it flows automatically
      into the assembly (FileVersion/AssemblyVersion), surfaced on the About page.

      Release policy:
        - Patch (3rd octave): bug fix / debugging an existing problem -> +1.
        - Minor (2nd octave): a small new feature -> +1.
        - Major (1st octave): DO NOT touch without explicit permission.
    -->
    <Version>0.20.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Copy the .ico next to the published .exe so the tray (LoadImage) and AppWindow.SetIcon find
         it at runtime — Content alone is NOT copied into the unpackaged self-contained publish. -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled notification sounds (four Flutter WAVs + three for-charm MP3s). Copied next to the
         published .exe — Content alone is NOT copied into the unpackaged self-contained publish — so
         NotificationSoundService can resolve them by file path via AppContext.BaseDirectory. -->
    <Content Include="Assets\Sounds\*.wav;Assets\Sounds\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Windows App SDK's self-contained publish does NOT lay down the Insights (telemetry)
         resource DLL, but AppNotificationManager.Register() tries to load it and throws
         "The specified module could not be found" on every launch of an installed build —
         leaving toasts visible but their click/reply/react activations unable to route back.
         A dev build hides this because it binds the machine-wide WindowsAppRuntime framework
         (which has the DLL); the installed self-contained build has no such framework. We
         vendor the matching 2.0.1 resource DLL and copy it next to the .exe so Register()
         succeeds. See Runtime\README.md for provenance / how to refresh on an SDK bump. -->
    <Content Include="Runtime\Microsoft.WindowsAppRuntime.Insights.Resource.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Flatten to the output root: the runtime resolves this resource DLL as a native
           sibling of Microsoft.WindowsAppRuntime.dll, so it must sit next to the .exe, not
           in a Runtime\ subfolder. -->
      <Link>Microsoft.WindowsAppRuntime.Insights.Resource.dll</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.8" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <!-- DPAPI credential protection (works unpackaged, unlike PasswordVault). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BlueBubbles.Core\BlueBubbles.Core.csproj" />
  </ItemGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">True</PublishTrimmed>
  </PropertyGroup>
</Project>